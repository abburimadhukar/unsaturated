# Postgres connection for the shared job corpus.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/unsaturated

# Identify the crawler honestly. Public ATS endpoints are fine to poll, but do it
# as a good citizen: real contact address, conservative concurrency.
CRAWLER_USER_AGENT=unsaturated-jobscout/0.1 (+mailto:you@example.com)

# Max concurrent board fetches. ATS vendors rate-limit per-IP; keep this low.
CRAWLER_CONCURRENCY=4

# Delay between individual board fetches, milliseconds.
CRAWLER_DELAY_MS=250
