node_modules/
.next/
dist/
.env
.env.local
*.log
.netlify/
# The snapshot is regenerated by every build; committing it would create
# pointless diffs and go stale immediately.
data/feed-snapshot.json

.open-next
.dev.vars
.wrangler

# Point-in-time copies of the boards table, taken before anything that writes.
# 13MB each and regenerable from the database; useful locally, pointless in git.
backups/

# Output of scripts/fill-live.mjs — screenshots of test fills
tmp-fill/

# Chrome for Testing, downloaded for the extension end-to-end check
chrome/

# TypeScript's own scratch list of what it has already checked. Rebuilt by
# every type-check, so committing it put a change in every diff.
tsconfig.tsbuildinfo

# Dated JSON written by the evidence scripts. Regenerable, and 320KB of it.
docs/evidence/
