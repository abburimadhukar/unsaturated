{
  "manifest_version": 3,
  "name": "Unsaturated — application autofill",
  "version": "0.1.1",
  "description": "Fills your own details into an employer's application form. You always press submit.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.ashbyhq.com/*",
    "https://*.workable.com/*",
    "https://*.recruitee.com/*",
    "https://*.rippling.com/*",
    "https://*.bamboohr.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkdaysite.com/*",
    "https://*.oraclecloud.com/*",
    "https://*.teamtailor.com/*",
    "https://*.personio.de/*",
    "https://*.personio.com/*",
    "https://*.eightfold.ai/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_title": "Fill this application" },
  "options_page": "src/options.html",
  "web_accessible_resources": [
    { "resources": ["src/matcher.js", "src/fill.js"], "matches": ["https://*/*"] }
  ]
}
