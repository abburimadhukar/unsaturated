{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unsaturated-jobs",
  "main": ".open-next/worker.js",

  // 2024-09-23 or later is required by the adapter; this is simply a recent one.
  "compatibility_date": "2025-03-01",

  // nodejs_compat is mandatory for Next.js on Workers.
  // global_fetch_strictly_public makes fetch() reach the public internet, which
  // is what the Supabase client does on every request.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Worker responses are NOT cached by Cloudflare unless this is on. With it,
  // the Cache-Control the feed route already sets is honoured — and unlike
  // Netlify, the query string is part of the cache key by default, so filters do
  // not collapse onto a single entry.
  "cache": {
    "enabled": true
  },

  // Run the Worker beside the database, not beside the visitor.
  //
  // Supabase is in us-east-1. Left to default, the Worker runs in whichever
  // Cloudflare city the visitor is nearest, and every database question crosses
  // that distance — /api/me alone makes several in a row. One trip from the
  // browser to Virginia is cheaper than several from the Worker to Virginia.
  //
  // A region hint rather than "smart": smart placement has to observe enough
  // traffic before it moves anything, and six people do not generate enough.
  // Static assets are unaffected (Cloudflare's placement docs) — they are still
  // served from the city nearest the visitor.
  "placement": {
    "region": "aws:us-east-1"
  },

  "observability": {
    "enabled": true
  }
}
