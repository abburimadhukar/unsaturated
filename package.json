{
  "name": "unsaturated",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "tsx src/cli/snapshot.ts && next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "discover": "tsx src/cli/discover.ts",
    "probe": "tsx src/cli/probe.ts",
